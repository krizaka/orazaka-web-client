{
  "host": "dev.orazaka.com",
  "iosBundleId": "com.krizaka.orazaka",
  "androidPackage": "com.krizaka.orazaka",
  "paths": [
    "/studios",
    "/studios/*",
    "/chat",
    "/jobs",
    "/settings",
    "/settings/*"
  ],
  "web": {
    "appDir": "src/app",
    "extra": [],
    "excluded": [
      "/",
      "/login",
      "/register",
      "/forgot-password",
      "/verify",
      "/privacy",
      "/terms",
      "/contact",
      "/docs",
      "/docs/*",
      "/features/*",
      "/gallery",
      "/models",
      "/desktop",
      "/pricing",
      "/open-source",
      "/console",
      "/console/*",
      "/dashboard/*",
      "/interceptions/*",
      "/usage",
      "/packs",
      "/automation"
    ],
    "aasaRoute": "src/app/.well-known/apple-app-site-association/route.ts",
    "assetlinksRoute": "src/app/.well-known/assetlinks.json/route.ts",
    "routesFile": "app-links.routes.json"
  }
}
