{
  "name": "orazaka-web-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "depcruise src --config .dependency-cruiser.cjs && next build",
    "start": "next start",
    "lint": "eslint && krizaka-ratchet",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "validate": "depcruise src --config .dependency-cruiser.cjs && npm run lint && npm run test:codemods && npm run test:coverage",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "npx playwright test",
    "test:e2e:ci": "npx playwright test --reporter=github",
    "test:codemods": "node --test scripts/codemods/*.test.mjs",
    "record:tour": "node scripts/record-tour.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@krizaka/icons": "^0.1.0-beta.0",
    "@krizaka/orazaka-design-system": "*",
    "@krizaka/orazaka-shared": "*",
    "@krizaka/tailwind": "^2.0.0-beta.1",
    "@krizaka/ui": "^2.0.0-beta.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "date-fns": "^4.3.0",
    "framer-motion": "^12.40.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@krizaka/config": "^0.1.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscodeshift": "^17.3.0",
    "prettier": "^3.2.5",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
