{
  "name": "orazaka-web-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/link-fonts.mjs",
    "predev": "node scripts/link-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/link-fonts.mjs",
    "build": "depcruise src --config .dependency-cruiser.cjs && next build",
    "start": "next start",
    "lint": "eslint && krizaka-ratchet && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs && node --test scripts/sg-ratchet.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "validate": "depcruise src --config .dependency-cruiser.cjs && npm run lint && npm run test:codemods && npm run test:deps && npm run check:deploy-build && npm run test:scripts && npm run test:coverage",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "npx playwright test",
    "test:e2e:ci": "npx playwright test --reporter=github",
    "test:codemods": "node --test scripts/codemods/*.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "record:tour": "node scripts/record-tour.mjs",
    "test:deps": "node --test scripts/krizaka-deps.test.mjs",
    "check:deploy-build": "AUTH_LOGIN_ENABLED=true AUTH_SIGNUP_ENABLED=true NODE_ENV=production ROUTER_URL=http://core:8088 NEXTAUTH_URL=https://dev.orazaka.com NEXTAUTH_SECRET=ci-build-only APP_COMMIT=ci next build",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@krizaka/charts": "^0.6.0",
    "@krizaka/fonts": "^0.2.1",
    "@krizaka/icons": "^0.1.0",
    "@krizaka/intl": "^0.1.0",
    "@krizaka/orazaka-design-system": "^3.4.0",
    "@krizaka/orazaka-shared": "^1.3.1",
    "@krizaka/tailwind": "^3.26.0",
    "@krizaka/tokens": "^3.26.0",
    "@krizaka/ui": "^3.26.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "date-fns": "^4.3.0",
    "framer-motion": "^14.1.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/config": "^0.1.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscodeshift": "^17.3.0",
    "prettier": "^3.2.5",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind"
  }
}
